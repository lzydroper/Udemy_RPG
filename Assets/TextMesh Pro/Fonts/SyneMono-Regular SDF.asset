    characterSequence: "// This code is part of the Fungus library (https://github.com/snozbot/fungus)\r\n//
      It is released for free under the MIT open source license (https://github.com/snozbot/fungus/blob/master/LICENSE)\r\n\r\nusing
      UnityEngine;\r\n\r\nnamespace Fungus\r\n{\r\n    /// <summary>\r\n    /// Command
      to execute and store the result of a Abs\r\n    /// </summary>\r\n    [CommandInfo(\"Math\",\r\n                
      \"Abs\",\r\n                 \"Command to execute and store the result of a
      Abs\")]\r\n    [AddComponentMenu(\"\")]\r\n    public class Abs : BaseUnaryMathCommand\r\n   
      {\r\n        public override void OnEnter()\r\n        {\r\n            outValue.Value
      = Mathf.Abs(inValue.Value);\r\n\r\n            Continue();\r\n        }\r\n   
      }\r\n}"
